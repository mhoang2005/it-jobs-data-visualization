digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.32", ranksep="1.05", splines=spline, outputorder=edgesfirst, fontname="Arial", labelloc=t, labeljust=l, label=<CƠ SỞ DỮ LIỆU • STAR SCHEMA<BR/><FONT POINT-SIZE="14" COLOR="#526880">1 fact + 9 dimension + 1 bảng cầu | Grain: một tin đăng / một phiên bản | PK: khóa chính; FK: khóa ngoại</FONT>>, fontsize=26];
node [shape=plain, fontname="Arial", fontcolor="#172B45"];
edge [color="#869BB2", penwidth=1.15, arrowsize=.65, fontname="Arial", fontsize=10, fontcolor="#536A83"];
