fact_job_posting [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F2F6FA"><TR><TD COLSPAN="2" BGCOLOR="#17365D" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="17"><B>fact_job_posting</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">PK</FONT></TD><TD PORT="snapshot_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">snapshot_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">&#160;</FONT></TD><TD PORT="posting_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">posting_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="version_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">version_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="posted_date_key" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">posted_date_key</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="source_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">source_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="company_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">company_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="role_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">role_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="seniority_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">seniority_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="location_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">location_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR=