posting_snapshot [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F2F6FA"><TR><TD COLSPAN="2" BGCOLOR="#17365D" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="17"><B>posting_snapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">PK</FONT></TD><TD PORT="id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="version_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">version_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="posting_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">posting_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="company_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">company_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="role_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">role_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="seniority_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">seniority_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="location_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">location_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">FK</FONT></TD><TD PORT="work_model_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">work_model_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">&#160;</FONT></TD><TD PORT="title" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">title</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#17365D" POINT-SIZE="11">&#16