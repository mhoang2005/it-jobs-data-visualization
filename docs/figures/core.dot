duplicate_candidate [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F2F6FA"><TR><TD COLSPAN="2" BGCOLOR="#A9651F" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="17"><B>duplicate_candidate</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#A9651F" POINT-SIZE="11">PK/FK</FONT></TD><TD PORT="version_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">version_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#A9651F" POINT-SIZE="11">PK/FK</FONT></TD><TD PORT="left_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">left_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#A9651F" POINT-SIZE="11">PK/FK</FONT></TD><TD PORT="right_id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">right_id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#A9651F" POINT-SIZE="11">&#160;</FONT></TD><TD PORT="score" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">score</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#A9651F" POINT-SIZE="11">&#160;</FONT></TD><TD PORT="reason" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">reason</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#A9651F" POINT-SIZE="11">&#160;</FONT></TD><TD PORT="decision" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">decision</FONT></TD></TR></TABLE>>];
