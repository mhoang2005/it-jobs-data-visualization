company [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F2F6FA"><TR><TD COLSPAN="2" BGCOLOR="#007F83" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="17"><B>company</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#007F83" POINT-SIZE="11">PK</FONT></TD><TD PORT="id" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">id</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#007F83" POINT-SIZE="11">&#160;</FONT></TD><TD PORT="name" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">name</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT COLOR="#007F83" POINT-SIZE="11">&#160;</FONT></TD><TD PORT="key" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="14">key</FONT></TD></TR></TABLE>>];
