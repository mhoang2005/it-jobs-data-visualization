digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.32", ranksep="1.05", splines=spline, outputorder=edgesfirst, fontname="Arial", labelloc=t, labeljust=l, label=<CƠ SỞ DỮ LIỆU • LÕI QUAN HỆ 3NF<BR/><FONT POINT-SIZE="14" COLOR="#526880">16 bảng | Mũi tên từ bảng được tham chiếu tới bảng chứa khóa ngoại | PK: khóa chính; FK: khóa ngoại</FONT>>, fontsize=26];
node [shape=plain, fontname="Arial", fontcolor="#172B45"];
edge [color="#869BB2", penwidth=1.15, arrowsize=.65, fontname="Arial", fontsize=10, fontcolor="#536A83"];
